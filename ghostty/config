command = /usr/local/bin/fish
# command = /usr/local/bin/brush
# command = /usr/local/bin/bash
# adjust-cell-width = 1
font-size = 20
# font-family = "Maple Mono NF CN"
# font-family = "Maple Mono Normal NF CN"
# font-family = "Hack Nerd Font"
# font-family = "Google Sans Code"
# font-family = "Jetbrain Mono Nerd Font"
font-family = "Iosevka Nerd Font"

# ==Only for font: Iosevka== #
# font-thicken = true
# font-thicken-strength = 100
# ========================== #
window-width = 160
window-height = 50

background-opacity = 0.75
background-blur-radius = 15
# background-image = "./云彩-夜晚-夜景.png"

cursor-invert-fg-bg = true
cursor-style = block
# custom-shader = "~/.config/ghostty/shaders/cursor_smear.glsl"

# theme = "Wez"
# theme = "Solarized Dark Patched"
# theme = "Carbonfox"
# theme = "Catppuccin Mocha"
theme = "Everforest Dark Hard"
# theme = "Rose Pine"

# shell-integration-features = no-cursor
shell-integration-features = true
# fish, zsh, bash ...
shell-integration = fish

quick-terminal-size = 50%,50%
# Keybindings
keybind = global:cmd+g=toggle_quick_terminal

keybind = cmd+s>\=new_split:right
keybind = cmd+s>-=new_split:down

keybind = cmd+s>l=goto_split:right
keybind = cmd+s>h=goto_split:left 
keybind = cmd+s>k=goto_split:up 
keybind = cmd+s>j=goto_split:down 

keybind = cmd+s>z=toggle_split_zoom 

keybind = cmd+s>e=equalize_splits

macos-option-as-alt = left
